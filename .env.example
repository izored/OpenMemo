# OpenMemo Environment Configuration
# Copy this file to .env and customize for your setup.
# All values shown here are defaults — uncomment to override.

# --- Backend API ---
# OLLAMA_HOST=http://host.docker.internal:11434
# OLLAMA_HOSTS=http://host.docker.internal:11434,http://ollama_gpu0:11434
# EMBED_MODEL=nomic-embed-text
# Must be a model you actually pulled (`ollama list`). If it isn't installed,
# openMemo falls back to the model picked in Settings, then to any installed
# chat model — but set it right so summaries use what you expect.
# DEFAULT_CHAT_MODEL=qwen2.5:7b
# DEFAULT_VISION_MODEL=gemma3:4b
# Ollama context window for chat/summary calls. Ollama's own default of 4096
# silently truncates long transcripts and RAG context.
# OLLAMA_NUM_CTX=8192
# RAG retrieval: chunks fetched per question, and the cosine-distance cutoff
# beyond which chunks are dropped as noise.
# RAG_TOP_K=8
# RAG_MAX_DISTANCE=0.80
# RAG_CANDIDATE_K=16      # chunk pool pulled before memo dedup (ADR-022)
# RAG_MAX_SOURCES=5       # distinct memos cited per answer
# RAG_CHUNKS_PER_MEMO=2   # best chunks per memo fed to the model
# DATABASE_URL=sqlite+aiosqlite:///./data/openmemo.db
# CHROMA_PERSIST_DIR=./data/chroma
# FILES_DIR=./files

# --- CORS Origins (comma-separated) ---
# Add your public domain here if using a reverse proxy / Cloudflare tunnel
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost,http://localhost:8091
