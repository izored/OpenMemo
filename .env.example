# OpenMemo Environment Configuration
# Copy this file to .env and customize for your setup.
# All values shown here are defaults — uncomment to override.

# --- Backend API ---
# OLLAMA_HOST=http://host.docker.internal:11434
# OLLAMA_HOSTS=http://host.docker.internal:11434,http://ollama_gpu0:11434
# EMBED_MODEL=nomic-embed-text
# DEFAULT_CHAT_MODEL=qwen2.5:7b
# DEFAULT_VISION_MODEL=gemma3:4b
# DATABASE_URL=sqlite+aiosqlite:///./data/openmemo.db
# CHROMA_PERSIST_DIR=./data/chroma
# FILES_DIR=./files

# --- CORS Origins (comma-separated) ---
# Add your public domain here if using a reverse proxy / Cloudflare tunnel
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost,http://openmemo.local
