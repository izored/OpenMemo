# openMemo environment configuration
#
# Copy to .env and change only what you need. Every value has a working default
# in backend/config.py, and docker-compose.yml already sets the ones that matter
# for the container, so a .env is optional.
#
# Commented lines show the shipped default.

# --- Ollama ------------------------------------------------------------------
# OLLAMA_HOST=http://host.docker.internal:11434
# Fallback list, tried in order when OLLAMA_HOST does not answer. Accepts either
# a comma-separated list or a JSON array string.
# OLLAMA_HOSTS=http://host.docker.internal:11434,http://ollama_gpu0:11434

# These must be models you actually pulled (`ollama list`). If one is not
# installed, openMemo falls back to the model picked in Settings, then to any
# installed chat model. The values below are what docker-compose.yml ships and
# what the README recommends; backend/config.py's own defaults are older and
# lighter (nomic-embed-text, qwen2.5:7b, gemma3:4b).
# EMBED_MODEL=nomic-embed-text-v2-moe
# DEFAULT_CHAT_MODEL=gemma4:e4b
# DEFAULT_VISION_MODEL=gemma4:e4b

# Context window for chat and summary calls. Ollama's own default of 4096
# silently truncates long transcripts and RAG context.
# OLLAMA_NUM_CTX=8192

# --- Storage -----------------------------------------------------------------
# DATABASE_URL=sqlite+aiosqlite:///./data/openmemo.db
# CHROMA_PERSIST_DIR=./data/chroma
# CHROMA_COLLECTION=memos
# FILES_DIR=./files

# Anchor all writable state (database, vector store, files) under one directory.
# The packaged macOS app sets this. Setting it re-derives the three paths above
# unless they are also set explicitly.
# DATA_DIR=./data

# Where faster-whisper caches its model. Point it inside a mounted volume so it
# downloads once instead of on every container recreate.
# HF_HOME=/app/data/hf-cache

# --- Server ------------------------------------------------------------------
# HOST=0.0.0.0
# PORT=8000

# Serve a built SPA from this directory, single-process, no nginx and no Vite.
# The macOS app sets this so the Electron window loads everything same-origin.
# Empty turns it off, which is what Docker and dev use.
# FRONTEND_DIST=

# --- Chunking and retrieval --------------------------------------------------
# CHUNK_SIZE must leave headroom inside the embedding model's context window
# (nomic-embed v1/v2 is 512 tokens) for the task prefix. Chunks that overflow
# get their tail silently truncated, so they embed as if the lost text never
# existed.
# CHUNK_SIZE=384
# CHUNK_OVERLAP=64

# Chunks fetched per question, and the cosine-distance cutoff beyond which a
# chunk is dropped as noise (0 is identical, 2 is opposite).
# RAG_TOP_K=8
# RAG_MAX_DISTANCE=0.80
# RAG_CANDIDATE_K=16      # chunk pool pulled before memo dedup (ADR-022)
# RAG_MAX_SOURCES=5       # distinct memos cited per answer
# RAG_CHUNKS_PER_MEMO=2   # best chunks per memo fed to the model

# --- Speech to text ----------------------------------------------------------
# WHISPER_MODEL=small          # tiny|base|small|medium|large-v3
# WHISPER_DEVICE=auto          # auto|cpu|cuda
# WHISPER_COMPUTE_TYPE=auto    # auto|int8|float16|float32
# WHISPER_BEAM_SIZE=1

# --- Media -------------------------------------------------------------------
# External ffmpeg used for video thumbnails and HLS/DASH muxing. Bare "ffmpeg"
# resolves via PATH; the packaged macOS app points this at its bundled binary.
# FFMPEG_BIN=ffmpeg

# --- CORS --------------------------------------------------------------------
# Add your public domain here if you front openMemo with a reverse proxy.
# CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost,http://localhost:8091

# Lock extension CORS to your exact extension origin (the ID from
# chrome://extensions). Empty accepts any chrome-extension:// origin.
# EXTENSION_ORIGIN=chrome-extension://abcdefghijklmnopabcdefghijklmnop

# --- Runtime switches --------------------------------------------------------
# These are read straight from the environment, not from Settings. They exist
# for packaging, development and the test suite.

# Which install this process is, used to pick the right copy for update
# instructions and data locations. One of: macos | docker | dev. Detected
# automatically; set it only if you package openMemo some other way.
# OPENMEMO_INSTALL=

# Stop this process polling the Telegram bot. Mandatory for any second backend
# (a dev checkout, a worktree). Telegram hands each message to exactly one
# caller, so a second poller does not duplicate captures, it steals them into
# whichever database that process is using.
# OPENMEMO_DISABLE_TELEGRAM=1

# Skip the background job worker pool entirely. The test suite sets this.
# OPENMEMO_DISABLE_JOB_WORKERS=1

# Port the Mesh sync listener binds. Override it to run two instances on one
# machine, which is what scripts/mesh-convergence-check.py needs.
# OPENMEMO_MESH_PORT=8770
