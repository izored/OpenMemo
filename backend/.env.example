# OpenMemo Backend Configuration
# Every value has a working default in backend/config.py - uncomment only what
# you need to change. Commented lines show the default.

# - Ollama --------------------------------------------------------------------
OLLAMA_HOST=http://localhost:11434
# Fallback list tried in order when OLLAMA_HOST is down (comma-separated)
OLLAMA_HOSTS=http://localhost:11434,http://host.docker.internal:11434,http://ollama_gpu0:11434,http://ollama_gpu1:11435
EMBED_MODEL=nomic-embed-text
DEFAULT_CHAT_MODEL=qwen2.5:7b
DEFAULT_VISION_MODEL=gemma3:4b
# Context window passed to Ollama chats (tokens)
# OLLAMA_NUM_CTX=8192

# - Storage -------------------------------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./data/openmemo.db
CHROMA_PERSIST_DIR=./data/chroma
FILES_DIR=./files
# Anchor ALL writable state (db, chroma, files) under one dir - used by the
# packaged macOS app. Setting this re-derives the three above unless they are
# also set explicitly.
# DATA_DIR=./data
# CHROMA_COLLECTION=memos

# - Server --------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
# Serve a built SPA from this dir (single-process mode, macOS app). Empty = off.
# FRONTEND_DIST=

# - RAG / chunking ------------------------------------------------------------
# CHUNK_SIZE=384
# CHUNK_OVERLAP=64
# RAG_TOP_K=8
# RAG_MAX_DISTANCE=0.80
# RAG_CANDIDATE_K=16      # chunk pool pulled before memo dedup (ADR-022)
# RAG_MAX_SOURCES=5       # distinct memos cited per answer
# RAG_CHUNKS_PER_MEMO=2   # best chunks per memo fed to the model

# - Speech-to-text (audio memos) ------------------------------------------------
# WHISPER_MODEL=small          # tiny|base|small|medium|large-v3
# WHISPER_DEVICE=auto          # auto|cpu|cuda
# WHISPER_COMPUTE_TYPE=auto    # auto|int8|float16|float32
# WHISPER_BEAM_SIZE=1

# - Media ---------------------------------------------------------------------
# FFMPEG_BIN=ffmpeg

# - CORS ----------------------------------------------------------------------
# Add your public domain here if using a reverse proxy / Cloudflare tunnel
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost,http://localhost:8091

# Lock extension CORS to your exact extension origin (ID from chrome://extensions).
# Empty = any chrome-extension:// origin is accepted (default, less strict).
# EXTENSION_ORIGIN=chrome-extension://abcdefghijklmnopabcdefghijklmnop
