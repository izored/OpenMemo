{
  "name": "openmemo-desktop",
  "productName": "OpenMemo",
  "version": "3.18.0",
  "description": "OpenMemo \u2014 your local AI knowledge OS, as a native macOS app.",
  "author": "izo.studio",
  "license": "MIT",
  "private": true,
  "repository": "https://github.com/izored/OpenMemo",
  "main": "dist-electron/main.js",
  "scripts": {
    "build:ts": "tsc -p tsconfig.json",
    "build:frontend": "npm --prefix ../frontend run build",
    "dev": "npm run build:ts && electron .",
    "bundle:backend": "node scripts/bundle-backend.mjs",
    "dist": "npm run build:ts && npm run build:frontend && npm run bundle:backend && electron-builder --mac --arm64 --publish never",
    "test": "npm run build:ts && node --test dist-electron/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "electron": "^34.0.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.7.2"
  }
}
